//
// The vast majority of what Niri looks like, minus what DMS manages.
//

prefer-no-csd // disables client-side decors

window-rule {
    background-effect {
        blur true    // blur for transparent windows
    }
}

// OpenWhispr dictation pill appearance tuning.
window-rule {
    match app-id="(?i)^open-whispr$" title="^Voice Recorder$"

    open-focused false    // false -> pill appears without stealing focus
    border      { off; }
    focus-ring  { off; }
    shadow      { off; }

    background-effect { blur false; xray false; }

    default-floating-position x=0 y=16 relative-to="top"
}
