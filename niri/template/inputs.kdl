// Input options DMS settings don't cover.
// niri doesn't merge touchpad/mouse blocks across files: this touchpad block
// replaces DMS's, so DMS touchpad toggles do nothing. Kept here for clickfinger.

input {
    touchpad {
        tap                                 // tap to click
        natural-scroll                      // content follows fingers
        dwt                                 // disable touchpad while typing
        scroll-method "two-finger"
        click-method "clickfinger"          // 1 finger=left, 2=right, 3=middle
    }

    // Hyprland-style: hover to focus & cursor jumps with keyboard focus
    focus-follows-mouse max-scroll-amount="25%"      // focus follows mouse
    warp-mouse-to-focus                              // move cursor to focus
}

clipboard {
    disable-primary    // disable select to copy & middle-click paste
}
