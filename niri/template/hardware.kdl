// Debug (experimental) options
// More info: https://github.com/niri-wm/niri/wiki/Configuration:-Debug-Options
debug {
    // Problem: Niri lag
    // Solution: Explicitly use iGPU for rendering Niri. 
    //
    // 1. `cardwire list` and find the RENDER for you iGPU
    // 2. Uncomment the line below and replace "renderD128" with your path
    //    if different. 
    //
    // ▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿
    // render-drm-device "/dev/dri/renderD128"

    // Problem: tearing or half-drawn frames on a monitor driven by a GPU
    //          other than `render-drm-device` 
    // e.g. ProArt P16 2025: eDP-1 and the USB-C/DP ports
    //   are on the iGPU; only the HDMI port is on the RTX 4060. Laptop screen
    //   plus USB-C monitors never need it, however many you connect.
    // Con: niri blocks until the GPU finishes each frame. Adds latency, and
    //   can appear as a freeze when GPU is heavily-loaded.
    // Leave off unless a screen on the other GPU shows artifacts.
    //
    // ▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿▿
    // wait-for-frame-completion-before-queueing

}
